# Install as an external root-readable environment file. Never commit real values.
CLAW_BRIDGE_TOKEN=replace-with-at-least-32-random-characters
CLAW_BRIDGE_HOST=127.0.0.1
CLAW_BRIDGE_PORT=19090
CLAW_BRIDGE_STATE_FILE=/home/clawrun/analise_storage/state/telegram-claw-projects.json
CLAW_PROJECTS_ROOT=/home/clawrun/analise_storage/telegram-projects
CLAW_BINARY=/home/clawrun/analise_storage/claw-code-parity/rust/target/release/claw
CLAW_MODEL=gemma4
# Preferred over CLAW_SYSTEM_PROMPT. The patched OpenAI-compatible provider
# reads this file for every model call, so prompt edits require only replacing
# the file; restarting the bridge is needed only when this path changes.
CLAW_SYSTEM_PROMPT_FILE=/home/clawrun/analise_storage/claw-code-parity/integrations/telegram/prompts/gemma4-abliterated-system-prompt.txt
CLAW_ALLOWED_TOOLS=all
CLAW_PERMISSION_MODE=danger-full-access
CLAW_UNRESTRICTED=1
# 0 means no wall-clock cutoff. `/stop` remains available through the separate
# control executor and terminates the selected process group.
CLAW_TURN_TIMEOUT=0
# Opt-in safety ceiling for a foreground Bash tool call that omitted its own
# timeout. Explicit per-command timeouts override this value. Keep 0/unset to
# preserve unlimited commands outside the dedicated production bridge.
CLAW_BASH_DEFAULT_TIMEOUT_MS=900000
CLAW_MAX_CONCURRENT=2
CLAW_BRIDGE_MAX_BODY_BYTES=67108864
CLAW_MAX_ATTACHMENT_BYTES=20971520
# This budget applies only to persisted conversation messages; the provider
# request also contains a large system prompt and tool schemas. The measured
# two-slot Gemma profile has 163840 tokens per slot. Compact at 64000 so those
# fixed request sections and the completion retain a real safety reserve.
CLAW_AUTO_COMPACT_INPUT_TOKENS=64000
# Match the current Claw Code default Opus completion budget. This is only a
# ceiling; normal answers stop naturally.
CLAW_GEMMA_MAX_OUTPUT_TOKENS=32000
# 0 removes the automatic OCR subprocess cutoff.
CLAW_OCR_TIMEOUT=0
CLAW_OCR_LANGUAGES=rus+eng
GOOGLE_BASE_URL=http://127.0.0.1:18080/v1
GOOGLE_API_KEY=local-gemma
